#!/usr/bin/env bash
#
# ctx - select a GCP account, project, and GKE cluster in quick succession,
# then set the active gcloud config and kube context, re-authing only if needed.
#
set -euo pipefail

# Resolve the real script directory, following symlinks, to find chrome-open.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

die() { echo "ctx: $*" >&2; exit 1; }

command -v gcloud >/dev/null 2>&1 || die "gcloud not found on PATH"
command -v fzf >/dev/null 2>&1 || die "fzf not found on PATH"

# Cache network lists for speed only, not to save network calls. Return the
# cached value at once, and always refresh in the background (stale=0s), so new
# clusters or projects show up on the next run. Falls back to a plain run if bkt
# is absent. --scope keeps lists for different accounts or projects apart.
CACHE_TTL=24h
CACHE_STALE=1s
cached() {
  local scope="$1"; shift
  if command -v bkt >/dev/null 2>&1; then
    bkt --ttl="$CACHE_TTL" --stale="$CACHE_STALE" --discard-failures \
      --scope="$scope" -- "$@"
  else
    "$@"
  fi
}

# Most recently chosen items come first in each menu. One history file per
# menu kind and scope, newest key on the first line.
RECENT_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ctx"
RECENT_LIMIT=50

recent_file() {
  mkdir -p "$RECENT_DIR"
  printf '%s/%s.recent' "$RECENT_DIR" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"
}

# Reorder stdin so keys listed in the history file come first, in history
# order. The key is the first whitespace-separated field of each line.
by_recency() {
  awk -v hist="$1" '
    BEGIN {
      n = 0
      while ((getline line < hist) > 0) if (line != "") rank[line] = ++n
    }
    { key = $1; order = rank[key] ? rank[key] : n + NR; keep[order] = $0; seen[order] = 1 }
    END { for (i = 1; i <= n + NR; i++) if (seen[i]) print keep[i] }
  '
}

remember() {
  local hist="$1" key="$2" tmp
  tmp="$(mktemp)"
  { printf '%s\n' "$key"; grep -vxF "$key" "$hist" 2>/dev/null || true; } \
    | head -n "$RECENT_LIMIT" > "$tmp"
  mv "$tmp" "$hist"
}

# Pick a value with fzf, newest choices first. Exits cleanly if cancelled.
pick() {
  local header="$1" hist choice
  hist="$(recent_file "${2:-$1}")"
  touch "$hist"
  choice="$(by_recency "$hist" \
    | fzf --height=40% --reverse --no-sort --prompt="$header> " --header="$header")" || true
  [[ -n "$choice" ]] || { echo "ctx: cancelled" >&2; exit 130; }
  remember "$hist" "$(awk '{print $1}' <<<"$choice")"
  printf '%s\n' "$choice"
}

# True if the account has a live session.
session_alive() {
  gcloud auth print-access-token --account="$1" >/dev/null 2>&1
}

# Find the Chrome profile directory whose signed-in user matches the account.
chrome_profile_dir() {
  python3 - "$1" <<'PY'
import json, os, sys
acct = sys.argv[1].lower()
p = os.path.expanduser("~/Library/Application Support/Google/Chrome/Local State")
with open(p) as f:
    d = json.load(f)
for dirn, meta in d.get("profile", {}).get("info_cache", {}).items():
    if meta.get("user_name", "").lower() == acct:
        print(dirn)
        break
PY
}

# Log in interactively, opening Chrome with the profile that matches the account.
reauth() {
  local account="$1"
  local profile
  profile="$(chrome_profile_dir "$account")"
  [[ -n "$profile" ]] || die "no Chrome profile signed in as $account"
  echo "ctx: session for $account is expired, logging in via Chrome '$profile'..." >&2
  CHROME_PROFILE="$profile" BROWSER="$SCRIPT_DIR/chrome-open" gcloud auth login "$account"
}

# 1. Pick account (local list, fast).
account="$(gcloud auth list --format='value(account)' | pick 'account')"

# 2. Make the account live before any network calls.
session_alive "$account" || reauth "$account"

# 3. Pick project for that account.
project="$(cached "$account" \
  gcloud projects list --account="$account" \
  --format='value(projectId)' --sort-by=projectId | pick 'project' "project-$account")"

# Apply the gcloud config in the background. Each `config set` costs about two
# seconds, so run them while the cluster menu is open.
( gcloud config set account "$account" >/dev/null 2>&1
  gcloud config set project "$project" >/dev/null 2>&1 ) &
config_pid=$!

# 4. Pick cluster, refined by project. Keep name and location together.
cluster_line="$(cached "$project" \
  gcloud container clusters list --project "$project" --account="$account" \
  --format='value(name,location)' | column -t | pick 'cluster' "cluster-$project")"
cluster_name="$(awk '{print $1}' <<<"$cluster_line")"
cluster_location="$(awk '{print $2}' <<<"$cluster_line")"

# 5. Set the kube context. The GKE plugin uses the now-live account.
wait "$config_pid"
gcloud container clusters get-credentials "$cluster_name" \
  --location "$cluster_location" --project "$project" --account="$account"

echo "ctx: ready -> $account / $project / $cluster_name ($cluster_location)"
