#!/usr/bin/env bash
#
# ctx - select a GCP account, project, and GKE cluster in quick succession,
# then set the active gcloud config and kube context, re-authing only if needed.
#
set -euo pipefail

# Resolve the real script directory, following symlinks, to find chrome-open.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

die() { echo "ctx: $*" >&2; exit 1; }

command -v gcloud >/dev/null 2>&1 || die "gcloud not found on PATH"
command -v fzf >/dev/null 2>&1 || die "fzf not found on PATH"

# Cache network lists. Return the cached value at once, refresh in the
# background. Falls back to a plain run if bkt is absent. --scope keeps lists
# for different accounts or projects apart.
CACHE_TTL=24h
CACHE_STALE=1m
cached() {
  local scope="$1"; shift
  if command -v bkt >/dev/null 2>&1; then
    bkt --ttl="$CACHE_TTL" --stale="$CACHE_STALE" --discard-failures \
      --scope="$scope" -- "$@"
  else
    "$@"
  fi
}

# Pick a value with fzf. Exits cleanly if the user cancels.
pick() {
  local header="$1"
  local choice
  choice="$(fzf --height=40% --reverse --prompt="$header> " --header="$header")" || true
  [[ -n "$choice" ]] || { echo "ctx: cancelled" >&2; exit 130; }
  printf '%s\n' "$choice"
}

# True if the account has a live session.
session_alive() {
  gcloud auth print-access-token --account="$1" >/dev/null 2>&1
}

# Find the Chrome profile directory whose signed-in user matches the account.
chrome_profile_dir() {
  python3 - "$1" <<'PY'
import json, os, sys
acct = sys.argv[1].lower()
p = os.path.expanduser("~/Library/Application Support/Google/Chrome/Local State")
with open(p) as f:
    d = json.load(f)
for dirn, meta in d.get("profile", {}).get("info_cache", {}).items():
    if meta.get("user_name", "").lower() == acct:
        print(dirn)
        break
PY
}

# Log in interactively, opening Chrome with the profile that matches the account.
reauth() {
  local account="$1"
  local profile
  profile="$(chrome_profile_dir "$account")"
  [[ -n "$profile" ]] || die "no Chrome profile signed in as $account"
  echo "ctx: session for $account is expired, logging in via Chrome '$profile'..." >&2
  CHROME_PROFILE="$profile" BROWSER="$SCRIPT_DIR/chrome-open" gcloud auth login "$account"
}

# 1. Pick account (local list, fast).
account="$(gcloud auth list --format='value(account)' | pick 'account')"

# 2. Make the account live before any network calls.
session_alive "$account" || reauth "$account"
gcloud config set account "$account" >/dev/null 2>&1

# 3. Pick project for that account.
project="$(cached "$account" \
  gcloud projects list --account="$account" \
  --format='value(projectId)' --sort-by=projectId | pick 'project')"
gcloud config set project "$project" >/dev/null 2>&1

# 4. Pick cluster, refined by project. Keep name and location together.
cluster_line="$(cached "$project" \
  gcloud container clusters list --project "$project" \
  --format='value(name,location)' | column -t | pick 'cluster')"
cluster_name="$(awk '{print $1}' <<<"$cluster_line")"
cluster_location="$(awk '{print $2}' <<<"$cluster_line")"

# 5. Set the kube context. The GKE plugin uses the now-live account.
gcloud container clusters get-credentials "$cluster_name" \
  --location "$cluster_location" --project "$project"

echo "ctx: ready -> $account / $project / $cluster_name ($cluster_location)"
